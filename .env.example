# Nansen API key — https://app.nansen.ai/api
NANSEN_API_KEY=

# Hard ceiling on credits any single process may spend (seed script, dev server). Default 500.
NANSEN_CREDIT_CAP=500

# free (default) or pro. Only tunes the client-side rate limiter pacing.
NANSEN_PLAN=free

# Where the call logger appends JSONL locally. Default: data/nansen-calls.jsonl
NANSEN_LOG_PATH=

# Disk cache directory for API responses. Default: .nansen-cache
NANSEN_CACHE_DIR=

# Optional: Upstash Redis REST creds. When set, the call log is also written here so the
# deployed store can show a live credit total across every app + the Railway cron.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: base URL where the Railway cron publishes fresh snapshots. Apps fall back to bundled JSON.
SNAPSHOT_BASE_URL=

# Store → app links. Production default: https://longitude-{id}.vercel.app ; dev uses localhost ports.
NEXT_PUBLIC_APP_URL_TEMPLATE=
NEXT_PUBLIC_STORE_URL=

# x402 "Pro refresh": visitors pay USDC for a fresh Nansen pull. Leave X402_PAY_TO empty to hide it.
# Network: eip155:84532 (Base Sepolia, public facilitator) or eip155:8453 (Base mainnet, PayAI facilitator).
X402_PAY_TO=
NEXT_PUBLIC_X402_PAY_TO=
X402_NETWORK=eip155:84532
NEXT_PUBLIC_X402_CHAIN_ID=84532
X402_PRICE=$0.05
NEXT_PUBLIC_X402_PRICE=$0.05
X402_FACILITATOR=

# Convex (recommended): shared social store, snapshot store and call log. From `npx convex dev` in packages/social.
CONVEX_URL=
# Seeds push snapshots with this token; set the same value in the Convex deployment: npx convex env set SEED_TOKEN ...
SEED_TOKEN=

# Protects the cron seed routes (Vercel Cron sends it as a bearer token)
CRON_SECRET=
