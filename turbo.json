{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NANSEN_API_KEY",
    "NANSEN_CREDIT_CAP",
    "NANSEN_LOG_PATH",
    "NANSEN_CACHE_DIR",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "SNAPSHOT_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "seed": {
      "cache": false,
      "outputs": ["snapshots/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
