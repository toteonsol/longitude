{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "pnpm seed:all --publish",
    "cronSchedule": "0 */6 * * *",
    "restartPolicyType": "NEVER"
  }
}
